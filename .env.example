# Docker deployment: copy to .env next to compose.yaml. See README.md "部署（Docker）".

# Where the app is served. APP_URL must be https://<CASHIER_HOST>: passkeys are bound to it.
CASHIER_HOST=cashier.example.com
APP_URL=https://cashier.example.com

# Host directory for the database and object storage (postgres/ and s3/ inside it).
# CASHIER_DATA_DIR=./data
# TZ=Asia/Kuala_Lumpur

# Random values, for example `openssl rand -hex 24`. They only need to stay the same across restarts.
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The one internal secret. Every signing and hashing key is derived from it, so keep it a secure
# random value, identical across restarts and upgrades.
AUTH_SECRET=

# AI provider
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# Optional email sign-in codes
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>

# Set to proxy only when the reverse proxy in front overwrites X-Real-IP with the client address
# and the app port is not reachable any other way. Otherwise every client shares one rate-limit bucket.
# TRUSTED_PROXY=proxy

# Advanced
# DATABASE_POOL_MAX=10
# LOG_LEVEL=info
