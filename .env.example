# Production deployment: set these in the Vercel project's environment variables.

# Application
# No account, ledger or book IDs are configured here: the first-run wizard at
# /setup creates them, using the setup code the server prints to its
# logs while the database is empty.
APP_URL=http://localhost:3000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/cashier?sslmode=require
# DATABASE_POOL_MAX=2

# S3 / Cloudflare R2 (bucket must already exist)
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cashier
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional authentication
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>
# DEV_AUTH_BYPASS=false

# The one internal secret. Every signing and hashing key is derived from it, so keep it a secure
# random value, identical across restarts, preview instances, and concurrent deployments.
# AUTH_SECRET=
# Only for deployments whose API keys were issued before AUTH_SECRET-derived hashing: keys hashed
# with the old pepper are rewritten on first use. Remove once every key has been used.
# API_KEY_PEPPER=
# Authenticates Vercel Cron's calls to /api/cron/daily. At least 32 characters; the cron refuses
# to run while it is unset.
# CRON_SECRET=

# Advanced
# TZ=Asia/Shanghai
# Optional. Set to platform only when Vercel is the ingress, or when a reverse proxy you control
# overwrites X-Real-IP with one client address. Missing or invalid addresses use an unknown bucket.
# TRUSTED_PROXY=platform
# LOG_LEVEL=info

