# Local development: copy to .env, run `npm run docker:local` for the backing
# services, then `npm run dev` for the app itself.
# PostgreSQL and MinIO use the fixed local-only credentials from docker-compose.local.yml.
# There are no account UUIDs to configure: the first-run wizard creates the
# account, the ledger and the books, and claims the instance with the setup code
# the server prints to its logs.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://cashier:cashier-local-only@localhost:5432/cashier

# Local MinIO, served by docker-compose.local.yml.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=cashier
S3_ACCESS_KEY_ID=cashier
S3_SECRET_ACCESS_KEY=cashier-local-only-secret
S3_FORCE_PATH_STYLE=true

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Public, fixed values for local development only. Replace every value before exposing the app.
AUTH_SECRET=cashier-local-only-auth-secret
API_KEY_PEPPER=cashier-local-only-api-key-pepper
AUTH_OTP_PEPPER=cashier-local-only-auth-otp-pepper

# Optional
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>
# AUTH_PASSWORD_EMAIL_MAX_ATTEMPTS=10
# AUTH_PASSWORD_IP_MAX_ATTEMPTS=50
# AUTH_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
# DEV_AUTH_BYPASS=false
# AI_CATEGORY_CONCURRENCY=100
# AI_CATEGORY_REQUEST_TIMEOUT_MS=60000
# AI_CATEGORY_MAX_ATTEMPTS=3
# S3_PORT=9000
# TZ=Asia/Shanghai
# LOG_LEVEL=info

# See docs/configuration.md for all supported variables and defaults.
