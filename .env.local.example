# Local development: copy to .env, run `npm run docker:local` for the backing
# services, then `npm run dev` for the app itself.
# PostgreSQL and the object store use the fixed local-only credentials from docker-compose.local.yml.
# There are no account UUIDs to configure: `npm run ledger:create`
# creates the ledger and the books. Sign in with DEV_AUTH_BYPASS=true,
# or point the OIDC_* values at your own provider.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://cashier:cashier-local-only@localhost:5432/cashier

# Local object store (Versity S3 Gateway), served by docker-compose.local.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=cashier
S3_ACCESS_KEY_ID=cashier
S3_SECRET_ACCESS_KEY=cashier-local-only-secret
S3_FORCE_PATH_STYLE=true

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Public, fixed values for local development only. Replace every value before exposing the app.
AUTH_SECRET=cashier-local-only-auth-secret

# OIDC provider. These are required at startup, but the provider is only contacted when someone
# signs in, so with DEV_AUTH_BYPASS=true the placeholders below are enough.
OIDC_ISSUER_URL=http://127.0.0.1:1
OIDC_CLIENT_ID=cashier-local
OIDC_CLIENT_SECRET=cashier-local-only-client-secret

# Optional
# DEV_AUTH_BYPASS=false
# S3_PORT=9000
# TZ=Asia/Shanghai
# LOG_LEVEL=info

# See docs/configuration.md for all supported variables and defaults.
