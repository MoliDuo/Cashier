# Bundled local-stack deployment: copy to .env.
# PostgreSQL and MinIO use fixed local-only credentials from docker-compose.local.yml.

INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
APP_URL=http://localhost:3000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Public, fixed values for local development only. Replace every value before exposing the app.
AUTH_SECRET=cashier-local-only-auth-secret
API_KEY_PEPPER=cashier-local-only-api-key-pepper
RATE_LIMIT_PEPPER=cashier-local-only-rate-limit-pepper
AUTH_OTP_PEPPER=cashier-local-only-auth-otp-pepper

# Optional
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>
# AUTH_PASSWORD_EMAIL_MAX_ATTEMPTS=10
# AUTH_PASSWORD_IP_MAX_ATTEMPTS=50
# AUTH_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
# DISABLE_REGISTRATION=false
# DEV_AUTH_BYPASS=false
# AI_CATEGORY_CONCURRENCY=100
# AI_CATEGORY_REQUEST_TIMEOUT_MS=60000
# AI_CATEGORY_MAX_ATTEMPTS=3
# APP_PORT=3000
# S3_PORT=9000
# TZ=Asia/Shanghai
# LOG_LEVEL=info

# See docs/configuration.md for all supported variables and defaults.
