{
  "name": "cashier",
  "version": "0.1.0",
  "description": "A self-hosted AI bookkeeping app for turning receipts and notes into a verifiable personal ledger.",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiangyu-Labs/Cashier.git"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "tsx --conditions=react-server scripts/run-demo.ts",
    "demo:reset": "tsx --conditions=react-server scripts/run-demo.ts --reset",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "tsc": "tsc --noEmit",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "check:dead-code": "knip --include files,dependencies,unlisted,unresolved,exports,types",
    "check:static": "npm run format:check && npm run check:architecture && npm run check:dead-code && npm run lint && npm run tsc",
    "check": "npm run check:static && npm run test:coverage && npm run build:check",
    "build:check": "tsx scripts/run-check-build.ts && tsx scripts/check-protected-route-bundle.ts",
    "test:prepare": "tsx scripts/prepare-test-postgres.ts",
    "test:smoke": "tsx --conditions=react-server scripts/run-smoke.ts",
    "test:demo": "tsx --conditions=react-server scripts/run-demo.ts --test",
    "test": "tsx scripts/run-vitest.ts run --config vitest.config.mts --project=unit-node --project=unit-dom",
    "test:watch": "tsx scripts/run-vitest.ts --watch --config vitest.config.mts --project=unit-node --project=unit-dom",
    "test:all": "tsx scripts/run-vitest.ts run --config vitest.config.mts",
    "test:integration": "tsx scripts/run-vitest.ts run --config vitest.config.mts --project=integration-node --project=integration-dom --reporter=dot",
    "test:coverage": "tsx scripts/run-vitest.ts run --config vitest.config.mts --coverage",
    "docker:local": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:studio": "drizzle-kit studio",
    "account:create": "tsx --conditions=react-server scripts/account.ts create",
    "account:enroll": "tsx --conditions=react-server scripts/account.ts enroll",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-email/components": "1.0.12",
    "@react-email/render": "^2.1.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "openai": "7.20.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@react-email/body": "0.3.0",
    "@react-email/tailwind": "1.0.0",
    "@babel/core@7": "7.29.7",
    "esbuild": "0.27.2",
    "picomatch@2": "2.3.2",
    "picomatch@3": "3.0.2",
    "picomatch@4": "4.0.5",
    "serialize-javascript@7": "7.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.14.5",
    "knip": "6.37.0",
    "msw": "2.15.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true,
    "@swc/core@1.15.18": true,
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
