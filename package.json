{
  "name": "cashier",
  "version": "0.1.0",
  "description": "A self-hosted AI bookkeeping app for turning receipts and notes into a verifiable personal ledger.",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiangyu-Labs/Cashier.git"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node scripts/run-demo.mjs",
    "demo:reset": "node scripts/run-demo.mjs --reset",
    "build": "next build --webpack && node scripts/check-protected-route-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "tsc": "tsc --noEmit",
    "i18n:generate": "node scripts/generate-i18n-catalogs.mjs",
    "validate:i18n": "node scripts/validate-i18n-catalogs.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:test-architecture": "node scripts/check-test-architecture.mjs",
    "check:dead-code": "knip --no-tag-hints --include files,dependencies,unlisted,unresolved,exports,types && knip --no-tag-hints --production --tags=-testOnly,-publicContract --include files,exports,types",
    "check:static": "npm run format:check && npm run check:architecture && npm run check:test-architecture && npm run check:dead-code && npm run lint && npm run tsc && npm run validate:i18n",
    "check:pr": "npm run check:static && npm run test:pr",
    "check": "npm run check:static && npm run test:coverage && npm run build:check",
    "build:check": "node scripts/run-check-build.mjs",
    "test:prepare": "node scripts/prepare-test-postgres.mjs",
    "test:smoke": "node scripts/run-smoke.mjs",
    "test:demo": "node scripts/run-demo.mjs --test",
    "test": "node scripts/run-vitest.mjs run --config vitest.config.mts --project=unit-node --project=unit-dom",
    "test:watch": "node scripts/run-vitest.mjs --watch --config vitest.config.mts --project=unit-node --project=unit-dom",
    "test:run": "node scripts/run-vitest.mjs run --config vitest.config.mts",
    "test:all": "node scripts/run-vitest.mjs run --config vitest.config.mts",
    "test:unit": "vitest run --config vitest.config.mts --project=unit-node --project=unit-dom",
    "test:integration": "node scripts/run-vitest.mjs run --config vitest.config.mts --project=integration-node --project=integration-dom --reporter=dot",
    "test:coverage": "node scripts/run-vitest.mjs run --config vitest.config.mts --coverage",
    "test:pr": "npm run test:unit && node scripts/run-pr-tests.mjs",
    "docker:local": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "db:push": "drizzle-kit push",
    "db:generate": "node scripts/guard-drizzle-generate.mjs && drizzle-kit generate",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "prune": "node scripts/prune-storage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-email/components": "1.0.10",
    "@react-email/render": "^2.1.0",
    "@serwist/next": "9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.13.4",
    "next-themes": "^0.4.6",
    "openai": "7.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "server-only": "0.0.1",
    "serwist": "9.5.12",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@react-email/body": "0.3.0",
    "@react-email/tailwind": "1.0.0",
    "@babel/core@7": "7.29.7",
    "esbuild": "0.27.2",
    "picomatch@2": "2.3.2",
    "picomatch@3": "3.0.2",
    "picomatch@4": "4.0.5",
    "serialize-javascript@7": "7.0.4"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.16",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "happy-dom": "^20.11.1",
    "knip": "6.34.0",
    "msw": "2.15.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true,
    "@swc/core@1.15.18": true,
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
